# NextGenSeeker 環境設定
# このファイルを .env にコピーし、キーを記入してください:
#   cp pipeline/.env.example pipeline/.env
# .env は .gitignore 済みで、run.sh / launchd が自動で読み込みます。

# Claude API を使うアナリスト解説を有効化（未設定ならルールベースで動作）
ANTHROPIC_API_KEY=

# 使用モデル（コスト重視: haiku。より高品質にするなら claude-opus-4-8 等）
NGS_MODEL=claude-haiku-4-5-20251001

# 任意: GitHub APIのレート制限緩和（未設定でも動作。60req/hで足ります）
GITHUB_TOKEN=

# Tiingo EOD（保有期間トレンド等の価格・出来高系）
TIINGO_API_KEY=

# FMP（決算サプライズ=PEAD・アナリスト格付。無料枠250req/日）
FMP_API_KEY=
